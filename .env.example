# ============================================================
# TalentIQ - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to version control

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://taliq:password@localhost:5432/taliq_dev

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ──────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-min-32-characters
JWT_REFRESH_SECRET=change-me-to-another-random-string-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI / LLM ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── File Upload ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api/v1
